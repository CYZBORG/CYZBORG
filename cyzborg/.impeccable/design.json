  "narrative": {
    "northStar": "The Augmented Athlete Campaign",
    "overview": "CYZBORG uses a black photographic campaign world: athletes, garments, music covers, and training tools supply the material. Copper marks primary commitment; blue marks audio, focus, and selection. White condensed headings and muted supporting copy maintain hierarchy without replacing official identity artwork.\n\nThe interface is dark-only, spacious at section boundaries, and compact inside controls. Rounded controls and charcoal media panels provide practical touch surfaces; full-width photography and restrained image shading carry atmosphere. Existing official logos, helmet, Z, hero lettering, covers, and brand backgrounds remain authoritative.",
    "keyCharacteristics": [
      "Dark-only black and charcoal surfaces with photographic depth.",
      "Copper primary actions; blue audio and focus states.",
      "Official hero lettering; self-hosted Oswald and Rajdhani.",
      "Rounded controls, contained garments, directional audio motion."
    ],
    "rules": [
      {
        "name": "The Accent Role Rule",
        "body": "Copper carries primary actions and selected commitment; blue carries audio emphasis and keyboard focus. Platform colors remain local to social tiles.",
        "section": "colors"
      },
      {
        "name": "The Artwork Authority Rule",
        "body": "Use official SVG lettering for the hero and official identity assets for logos. Conthrax is selective; supporting headings use Oswald.",
        "section": "typography"
      },
      {
        "name": "The Photographic Depth Rule",
        "body": "Use charcoal surfaces, image shading, and subtle brand artwork for depth. Reserve structural shadows for attached menus and dialogs.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve official logos, helmet, Z, SVG slogan, apparel mockups, album covers, and approved background artwork.",
      "Do contain garment mockups and enlarged front/back views; use cover cropping for campaign photography.",
      "Do keep Share Your Input inside the attached mobile menu, preserve navigation order, and allow the menu to scroll within the viewport.",
      "Do retain blue focus outlines, reduced-motion behavior, and meaningful touch targets.",
      "Do use platform color only inside its matching social tile."
    ],
    "donts": [
      "Don't replace approved hero lettering with live text or generated lettering.",
      "Don't introduce a light mode, logo glow, fabricated product claims, or unapproved motivational copy.",
      "Don't spread Conthrax across body copy or turn release status labels into decorative section kickers.",
      "Don't enforce square artwork proportions around the 352px embedded audio player."
    ]
  }
