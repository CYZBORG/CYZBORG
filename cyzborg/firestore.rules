rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'cyzborg.official@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // 3. Validation Blueprint for ShirtVote
    function isValidShirtVote(data, voteId) {
      return data.keys().hasAll(['shirtId', 'visitorId', 'createdAt']) &&
             data.keys().hasOnly(['shirtId', 'visitorId', 'createdAt']) &&
             data.shirtId is string &&
             data.shirtId.size() >= 1 &&
             data.shirtId.size() <= 64 &&
             data.shirtId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.visitorId is string &&
             data.visitorId.size() >= 8 &&
             data.visitorId.size() <= 64 &&
             data.visitorId.matches('^[a-zA-Z0-9_\\-]+$') &&
             voteId == data.shirtId + '__' + data.visitorId &&
             data.createdAt == request.time;
    }

    // 4. Validation Blueprint for ChatSession
    function isValidChatSession(data, sessionId) {
      return data.keys().hasAll(['visitorId', 'summary', 'transcript', 'messageCount', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['visitorId', 'summary', 'transcript', 'messageCount', 'createdAt', 'updatedAt']) &&
             data.visitorId is string &&
             data.visitorId.size() >= 8 &&
             data.visitorId.size() <= 64 &&
             data.visitorId.matches('^[a-zA-Z0-9_\\-]+$') &&
             sessionId == 'chat_' + data.visitorId &&
             data.summary is string &&
             data.summary.size() >= 1 &&
             data.summary.size() <= 1000 &&
             data.transcript is string &&
             data.transcript.size() >= 1 &&
             data.transcript.size() <= 12000 &&
             data.messageCount is int &&
             data.messageCount >= 1 &&
             data.messageCount <= 200 &&
             data.updatedAt == request.time;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /shirtVotes/{voteId} {
      // Single-document lookup by deterministic key (shirtId__visitorId)
      allow get: if isValidId(voteId);

      // Private aggregate totals: ONLY the verified site owner can list all votes
      allow list: if isAdmin() && resource.data.shirtId is string && resource.data.shirtId.size() <= 64;

      // Anonymous visitor can cast 1 vote per shirt/colorway using deterministic voteId
      allow create: if isValidId(voteId) && isValidShirtVote(incoming(), voteId);

      // Votes are binary (create or remove); updates are forbidden
      allow update: if false;

      // Second click removes the visitor's vote by deterministic voteId
      allow delete: if isValidId(voteId);
    }

    match /chatSessions/{sessionId} {
      // Single-document lookup by deterministic key ('chat_' + visitorId)
      allow get: if isValidId(sessionId);

      // Private owner inbox: ONLY the verified site owner can list all recorded chat sessions
      allow list: if isAdmin() && resource.data.visitorId is string && resource.data.visitorId.size() <= 64;

      // Visitor creates their recorded chat session
      allow create: if isValidId(sessionId) &&
                    isValidChatSession(incoming(), sessionId) &&
                    incoming().createdAt == request.time;

      // Visitor appends new messages to their recorded chat session
      allow update: if isValidId(sessionId) &&
                    isValidChatSession(incoming(), sessionId) &&
                    incoming().visitorId == existing().visitorId &&
                    incoming().createdAt == existing().createdAt;

      allow delete: if isAdmin() && isValidId(sessionId);
    }
  }
}
